{
  "manifest_version": 3,
  "name": "Open Computer Use browser bridge",
  "version": "2.0.0",
  "description": "Native browser organization and selected-tab identity for Open Computer Use.",
  "permissions": [
    "tabs",
    "debugger",
    "tabGroups",
    "bookmarks",
    "storage"
  ],
  "key": "",
  "minimum_chrome_version": "137",
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  }
}
